# Copy to backend/.env for local development:  copy .env.example .env
# On Render, set these as environment variables in the dashboard instead.

DATA_MODE=demo                       # demo | live
FIRMS_MAP_KEY=                       # NASA FIRMS MAP_KEY (server-side only, never in frontend)

# Live mode (optional; these are the defaults)
# LIVE_REGIONS=punjab-haryana|Punjab & Haryana|73.5,28.5,77.5,32.5;south-india|South India|74.0,8.0,84.8,20.0
# LIVE_DAYS=3                          # 1-10 (a region with no fires in that time looks back 10 days)
# LIVE_CACHE_MINUTES=60
# LIVE_RETRY_MINUTES=5

# Default harmonization parameters (prototype values; each request can override them)
# Leave the first two unset to use the defaults: 1 km / 30 min in demo mode, 2 km / 180 min in live mode
# (MODIS Aqua now passes ~2-3 h after VIIRS over India; see README).
# SPATIAL_MATCH_RADIUS_KM=1.0
# TEMPORAL_MATCH_WINDOW_MINUTES=30
CONFIDENCE_THRESHOLD=30

# Comma-separated frontend origins allowed to call the API
# Add your Vercel URL here when deploying, e.g. http://localhost:5173,https://fireharmonize.vercel.app
CORS_ORIGINS=http://localhost:5173
