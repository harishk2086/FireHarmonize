# Copy to backend/.env for local development:  copy .env.example .env
# On Render, set these as environment variables in the dashboard instead.

DATA_MODE=demo                       # demo | live  (live mode is not implemented yet; returns HTTP 501)
FIRMS_MAP_KEY=                       # NASA FIRMS MAP_KEY (server-side only, never in frontend)

# Default harmonization parameters (prototype values; each request can override them)
SPATIAL_MATCH_RADIUS_KM=1.0
TEMPORAL_MATCH_WINDOW_MINUTES=30
CONFIDENCE_THRESHOLD=30

# Comma-separated frontend origins allowed to call the API
# Add your Vercel URL here when deploying, e.g. http://localhost:5173,https://fireharmonize.vercel.app
CORS_ORIGINS=http://localhost:5173
