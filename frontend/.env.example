# Leave VITE_API_URL empty for local development: the Vite dev server proxies /api to http://localhost:8000.
# For production (Vercel), set it to the deployed backend URL without a trailing slash,
# e.g. VITE_API_URL=https://fireharmonize-api.onrender.com
VITE_API_URL=

# ArcGIS Location Platform API key (public-application key, Static basemap tiles privilege only,
# restricted by referrer to your site addresses). Put the real value in frontend/.env.local
# (git-ignored) for local development, and in the Vercel project's environment variables.
VITE_ARCGIS_API_KEY=
